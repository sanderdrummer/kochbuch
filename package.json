    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.11.1",
    "@testing-library/cypress": "^10.0.2",
    "@types/dexie": "^1.3.32",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.4.19",
    "cypress": "^13.13.3",
    "eslint": "^8.38.0",
